    {
      "value": "\"codigo\" ~ '^[a-z][a-z0-9]{1,19}$'",
      "name": "fonte_codigo_valido",
      "entityType": "checks",
      "schema": "precos",
      "table": "fonte"
    },
    {
      "value": "\"preco_centavos\" > 0 AND \"preco_lista_centavos\" > 0",
      "name": "observacao_preco_positivo",
      "entityType": "checks",
      "schema": "precos",
      "table": "observacao"
    },
    {
      "value": "\"situacao\" <> 'OK' OR \"preco_centavos\" IS NOT NULL",
      "name": "observacao_ok_tem_preco",
      "entityType": "checks",
      "schema": "precos",
      "table": "observacao"
    },
    {
      "value": "\"situacao\" NOT IN ('SEM_PRECO', 'NAO_ENCONTRADO', 'ERRO') OR (\"preco_centavos\" IS NULL AND \"preco_lista_centavos\" IS NULL)",
      "name": "observacao_sem_preco_sem_valor",
      "entityType": "checks",
      "schema": "precos",
      "table": "observacao"
    },
    {
      "value": "\"situacao\" <> 'ERRO' OR \"detalhe\" IS NOT NULL",
      "name": "observacao_erro_tem_detalhe",
      "entityType": "checks",
      "schema": "precos",
      "table": "observacao"
    },
    {
      "value": "\"ean\" ~ '^[0-9]{8,14}$'",
      "name": "produto_ean_valido",
      "entityType": "checks",
      "schema": "precos",
      "table": "produto"
    },
    {
      "value": "\"nosso_preco_centavos\" > 0",
      "name": "produto_nosso_preco_positivo",
      "entityType": "checks",
      "schema": "precos",
      "table": "produto"
    },
    {
      "value": "(\"situacao\" = 'RODANDO') = (\"concluida_em\" IS NULL)",
      "name": "rodada_aberta_so_rodando",
      "entityType": "checks",
      "schema": "precos",
      "table": "rodada"
    }
