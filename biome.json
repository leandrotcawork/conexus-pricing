{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!package-lock.json", "!migrations"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 60,
            "skipBlankLines": true
          }
        }
      },
      "style": {
        "noDefaultExport": "error",
        "useThrowOnlyError": "error",
        "noProcessEnv": "error",
        "noNonNullAssertion": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 300,
            "skipBlankLines": true
          }
        },
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "pg": "Only src/banco/conexao.ts imports pg (data D19).",
              "@neon/functions": "Only src/banco/conexao.ts imports @neon/functions (data D19).",
              "@crawlee/http": "Only src/coleta/http.ts imports Crawlee (code C56).",
              "@modelcontextprotocol/server": "Only src/mcp/ imports the MCP server SDK.",
              "oracledb": "Only scripts/carga-catalogo.ts imports oracledb."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noThisOutsideOfClass": "error",
        "noUnsafeTypeAssertion": "error",
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "style": "declaration"
          }
        },
        "useExhaustiveSwitchCases": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/plataformas/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only src/banco/conexao.ts imports pg (data D19).",
                  "@neon/functions": "Only src/banco/conexao.ts imports @neon/functions (data D19).",
                  "@crawlee/http": "Only src/coleta/http.ts imports Crawlee (code C56).",
                  "@modelcontextprotocol/server": "Only src/mcp/ imports the MCP server SDK.",
                  "oracledb": "Only scripts/carga-catalogo.ts imports oracledb."
                },
                "patterns": [
                  {
                    "group": [
                      "../**/banco/**",
                      "../**/coleta/**",
                      "../**/mcp/**",
                      "../**/funcoes/**",
                      "../**/config.ts",
                      "../**/scripts/**"
                    ],
                    "message": "src/plataformas/ imports only dominio/ and its own files (section 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/coleta/**", "!**/*.test.ts", "!src/coleta/http.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only src/banco/conexao.ts imports pg (data D19).",
                  "@neon/functions": "Only src/banco/conexao.ts imports @neon/functions (data D19).",
                  "@crawlee/http": "Only src/coleta/http.ts imports Crawlee (code C56).",
                  "@modelcontextprotocol/server": "Only src/mcp/ imports the MCP server SDK.",
                  "oracledb": "Only scripts/carga-catalogo.ts imports oracledb."
                },
                "patterns": [
                  {
                    "group": [
                      "../**/mcp/**",
                      "../**/funcoes/**",
                      "../**/config.ts",
                      "../**/scripts/**"
                    ],
                    "message": "src/coleta/ imports only dominio/, plataformas/, banco/ and its own files (section 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/coleta/http.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only src/banco/conexao.ts imports pg (data D19).",
                  "@neon/functions": "Only src/banco/conexao.ts imports @neon/functions (data D19).",
                  "@modelcontextprotocol/server": "Only src/mcp/ imports the MCP server SDK.",
                  "oracledb": "Only scripts/carga-catalogo.ts imports oracledb."
                },
                "patterns": [
                  {
                    "group": [
                      "../**/mcp/**",
                      "../**/funcoes/**",
                      "../**/config.ts",
                      "../**/scripts/**"
                    ],
                    "message": "src/coleta/ imports only dominio/, plataformas/, banco/ and its own files (section 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/banco/**", "!**/*.test.ts", "!src/banco/conexao.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only src/banco/conexao.ts imports pg (data D19).",
                  "@neon/functions": "Only src/banco/conexao.ts imports @neon/functions (data D19).",
                  "@crawlee/http": "Only src/coleta/http.ts imports Crawlee (code C56).",
                  "@modelcontextprotocol/server": "Only src/mcp/ imports the MCP server SDK.",
                  "oracledb": "Only scripts/carga-catalogo.ts imports oracledb."
                },
                "patterns": [
                  {
                    "group": [
                      "../**/plataformas/**",
                      "../**/coleta/**",
                      "../**/mcp/**",
                      "../**/funcoes/**",
                      "../**/config.ts",
                      "../**/scripts/**"
                    ],
                    "message": "src/banco/ imports only dominio/ and its own files (section 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/banco/conexao.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@crawlee/http": "Only src/coleta/http.ts imports Crawlee (code C56).",
                  "@modelcontextprotocol/server": "Only src/mcp/ imports the MCP server SDK.",
                  "oracledb": "Only scripts/carga-catalogo.ts imports oracledb."
                },
                "patterns": [
                  {
                    "group": [
                      "../**/plataformas/**",
                      "../**/coleta/**",
                      "../**/mcp/**",
                      "../**/funcoes/**",
                      "../**/config.ts",
                      "../**/scripts/**"
                    ],
                    "message": "src/banco/ imports only dominio/ and its own files (section 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/mcp/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only src/banco/conexao.ts imports pg (data D19).",
                  "@neon/functions": "Only src/banco/conexao.ts imports @neon/functions (data D19).",
                  "@crawlee/http": "Only src/coleta/http.ts imports Crawlee (code C56).",
                  "oracledb": "Only scripts/carga-catalogo.ts imports oracledb."
                },
                "patterns": [
                  {
                    "group": [
                      "../**/plataformas/**",
                      "../**/coleta/**",
                      "../**/funcoes/**",
                      "../**/config.ts",
                      "../**/scripts/**",
                      "../**/banco/**",
                      "!../**/banco/leituras.ts"
                    ],
                    "message": "src/mcp/ imports only dominio/, banco/leituras.ts and its own files (section 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/funcoes/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only src/banco/conexao.ts imports pg (data D19).",
                  "@neon/functions": "Only src/banco/conexao.ts imports @neon/functions (data D19).",
                  "@crawlee/http": "Only src/coleta/http.ts imports Crawlee (code C56).",
                  "@modelcontextprotocol/server": "Only src/mcp/ imports the MCP server SDK.",
                  "oracledb": "Only scripts/carga-catalogo.ts imports oracledb."
                },
                "patterns": [
                  {
                    "group": [
                      "../**/dominio/**",
                      "../**/plataformas/**",
                      "../**/banco/**",
                      "../**/scripts/**"
                    ],
                    "message": "src/funcoes/ imports only config.ts, coleta/, mcp/ and its own files (section 5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/carga-catalogo.ts", "scripts/carga-catalogo.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "pg": "Only src/banco/conexao.ts imports pg (data D19).",
                  "@neon/functions": "Only src/banco/conexao.ts imports @neon/functions (data D19).",
                  "@crawlee/http": "Only src/coleta/http.ts imports Crawlee (code C56).",
                  "@modelcontextprotocol/server": "Only src/mcp/ imports the MCP server SDK."
                },
                "patterns": [
                  {
                    "group": [
                      "../**/plataformas/**",
                      "../**/coleta/**",
                      "../**/mcp/**",
                      "../**/funcoes/**"
                    ],
                    "message": "scripts/carga-catalogo.ts imports only dominio/, banco/ and config.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/dominio/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./*", "!zod"],
                    "message": "src/dominio/ imports only zod and its own files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["src/funcoes/*.ts", "drizzle.config.ts", "neon.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
